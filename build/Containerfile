FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:10.2-1791463156 as builder

ENV EXTENSION_SRC=/opt/app-root/src
RUN mkdir -p $EXTENSION_SRC
WORKDIR $EXTENSION_SRC

# pnpm runs an implicit dependency check before `run` scripts, which spawns a
# nested `pnpm install`. That nested call does not inherit a per-command
# `CI=true`, so inside a container it blocks on an interactive prompt and the
# build hangs. Setting CI on the environment makes every pnpm invocation
# non-interactive.
ENV CI=true

COPY --chown=1001:1001 . .

RUN npm i -g pnpm@12.10.1
RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN mkdir -p /tmp/extension && \
    cp -r dist www icons package.json icon.png redhat-icon.woff2 LICENSE README.md /tmp/extension/

FROM scratch

LABEL org.opencontainers.image.title="Red Hat Account" \
  org.opencontainers.image.description="Allows the ability in Podman Desktop to login to Red Hat SSO" \
  org.opencontainers.image.vendor="Red Hat" \
  io.podman-desktop.api.version=">= 1.9.0"

COPY --from=builder /tmp/extension /extension
